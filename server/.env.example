# PostgreSQL connection string (local Docker, Neon, or any Postgres provider)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API server listens on
PORT=4000

# Allowed CORS origin (the Vite dev server)
CLIENT_URL="http://localhost:5173"
